<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AuditIQ Report — {{ record.config.target_url }}</title>
  <style>
    :root {
      --primary: {{ branding.colors.primary | default('#1E293B') }};
      --secondary: {{ branding.colors.secondary | default('#0284C7') }};
      --accent: {{ branding.colors.accent | default('#10B981') }};
      --warning: {{ branding.colors.warning | default('#F59E0B') }};
      --danger: {{ branding.colors.danger | default('#EF4444') }};
      --bg: {{ branding.colors.background | default('#F8FAFC') }};
      --text: {{ branding.colors.text | default('#0F172A') }};
      --font-family: {{ branding.typography.font_family | default('Inter, sans-serif') }};
      --card-bg: #FFFFFF;
      --border-color: #E2E8F0;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: var(--font-family);
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.6;
      padding: 40px 20px;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
    }

    /* Header */
    header {
      background: var(--card-bg);
      border-radius: 12px;
      padding: 30px;
      margin-bottom: 30px;
      border: 1px solid var(--border-color);
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }
    .brand-title {
      font-size: 24px;
      font-weight: 800;
      color: var(--primary);
    }
    .brand-tagline {
      font-size: 13px;
      color: #64748B;
      margin-top: 4px;
    }
    .meta-box {
      text-align: right;
      font-size: 13px;
      color: #64748B;
    }
    .meta-box strong { color: var(--text); }

    /* Executive Hero */
    .hero-grid {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 25px;
      margin-bottom: 30px;
    }
    .card {
      background: var(--card-bg);
      border-radius: 12px;
      padding: 25px;
      border: 1px solid var(--border-color);
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }
    .grade-card {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .grade-badge {
      width: 130px;
      height: 130px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 54px;
      font-weight: 900;
      color: #FFFFFF;
      margin-bottom: 15px;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }
    .grade-A { background: var(--accent); }
    .grade-B { background: #3B82F6; }
    .grade-C { background: var(--warning); }
    .grade-D { background: #F97316; }
    .grade-F { background: var(--danger); }

    .score-number {
      font-size: 20px;
      font-weight: 700;
      color: var(--primary);
    }
    .score-sub {
      font-size: 13px;
      color: #64748B;
    }

    /* Layer Breakdown Grid */
    .layer-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }
    .layer-item {
      background: #F1F5F9;
      border-radius: 8px;
      padding: 15px;
    }
    .layer-header {
      display: flex;
      justify-content: space-between;
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 8px;
    }
    .progress-bar-bg {
      background: #E2E8F0;
      height: 8px;
      border-radius: 4px;
      overflow: hidden;
    }
    .progress-bar-fill {
      height: 100%;
      border-radius: 4px;
    }

    /* Priority Action Matrix */
    .section-title {
      font-size: 20px;
      font-weight: 800;
      color: var(--primary);
      margin-bottom: 20px;
      border-left: 4px solid var(--secondary);
      padding-left: 12px;
    }
    .matrix-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      margin-bottom: 35px;
    }
    .quadrant {
      border-radius: 10px;
      padding: 20px;
      border: 1px solid var(--border-color);
    }
    .quad-quick-wins { background: #F0FDF4; border-color: #BBF7D0; }
    .quad-major-projects { background: #EFF6FF; border-color: #BFDBFE; }
    .quad-fill-ins { background: #FEFCE8; border-color: #FEF08A; }
    .quad-thankless { background: #F8FAFC; border-color: #E2E8F0; }

    .quad-title {
      font-size: 15px;
      font-weight: 800;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .quad-action-list {
      list-style: none;
      font-size: 13px;
    }
    .quad-action-item {
      padding: 8px 0;
      border-bottom: 1px solid rgba(0, 0, 0, 0.05);
      display: flex;
      justify-content: space-between;
      gap: 10px;
    }

    /* Live Visibility Table */
    .vis-box {
      margin-bottom: 35px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      margin-top: 10px;
    }
    th, td {
      padding: 12px 14px;
      text-align: left;
      border-bottom: 1px solid var(--border-color);
    }
    th {
      background: #F1F5F9;
      font-weight: 700;
      color: var(--primary);
    }
    .pill {
      display: inline-block;
      padding: 3px 8px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
    }
    .pill-pass { background: #DCFCE7; color: #166534; }
    .pill-warning { background: #FEF3C7; color: #92400E; }
    .pill-fail { background: #FEE2E2; color: #991B1B; }
    .pill-info { background: #E0F2FE; color: #075985; }
    .pill-not-measured { background: #F1F5F9; color: #64748B; }

    /* Findings Accordion / Cards */
    .finding-card {
      background: var(--card-bg);
      border-radius: 8px;
      padding: 16px 20px;
      margin-bottom: 12px;
      border: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .finding-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .finding-title {
      font-size: 15px;
      font-weight: 700;
      color: var(--primary);
    }
    .finding-meta {
      font-size: 12px;
      color: #64748B;
    }
    .finding-guidance {
      background: #F8FAFC;
      border-left: 3px solid var(--secondary);
      padding: 8px 12px;
      font-size: 12px;
      color: #334155;
    }

    /* Footer */
    footer {
      margin-top: 50px;
      padding-top: 25px;
      border-top: 1px solid var(--border-color);
      text-align: center;
      font-size: 12px;
      color: #94A3B8;
    }

    @media print {
      body { background: #FFF; padding: 0; }
      .container { max-width: 100%; }
      .card { box-shadow: none; }
      .page-break { page-break-before: always; }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <header>
      <div>
        <div class="brand-title">{{ branding.agency.name | default('AuditIQ Intelligence') }}</div>
        <div class="brand-tagline">{{ branding.agency.tagline | default('AI Search & Technical SEO Engine') }}</div>
      </div>
      <div class="meta-box">
        <div>Target: <strong>{{ record.config.target_url }}</strong></div>
        <div>Brand: <strong>{{ record.config.brand_name or record.crawl_summary.get('base_domain', 'Primary Domain') }}</strong></div>
        <div>Audit ID: <strong>{{ record.id }}</strong> | Date: <strong>{{ record.created_at.strftime('%B %d, %Y') }}</strong></div>
      </div>
    </header>

    <!-- Executive Summary Hero -->
    <div class="hero-grid">
      <div class="card grade-card">
        <div class="grade-badge grade-{{ record.score_card.letter_grade }}">
          {{ record.score_card.letter_grade }}
        </div>
        <div class="score-number">{{ record.score_card.composite_score }} / 100</div>
        <div class="score-sub">Composite AuditIQ Index (v{{ record.score_card.scoring_version }})</div>
      </div>

      <div class="card">
        <h3 style="margin-bottom: 12px; color: var(--primary);">Audit Layer Performance</h3>
        <p style="font-size: 13px; color: #64748B; margin-bottom: 18px;">
          Dynamic proportional weighting evaluated across {{ record.crawl_summary.get('total_pages', 0) }} pages.
        </p>
        <div class="layer-grid">
          {% for layer, score in record.score_card.layer_scores.items() %}
          <div class="layer-item">
            <div class="layer-header">
              <span>{{ layer.value.replace('_', ' ').title() }}</span>
              <span>
                {% if score is not none %}
                  <strong>{{ "%.1f"|format(score) }}</strong>/100
                {% else %}
                  <em>Not measured</em>
                {% endif %}
              </span>
            </div>
            <div class="progress-bar-bg">
              <div class="progress-bar-fill" style="width: {{ score if score is not none else 0 }}%; background: {% if score is none %}#CBD5E1{% elif score >= 80 %}var(--accent){% elif score >= 60 %}var(--warning){% else %}var(--danger){% endif %};"></div>
            </div>
            <div style="font-size: 11px; color: #64748B; margin-top: 5px;">
              Weight: {{ "%.0f"|format(record.score_card.layer_weights.get(layer, 0) * 100) }}%
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- Priority Action Matrix -->
    {% if record.score_card.priority_actions %}
    <div class="section-title">Priority Remediation Matrix (Impact × Effort)</div>
    <div class="matrix-grid">
      <!-- Quick Wins -->
      <div class="quadrant quad-quick-wins">
        <div class="quad-title" style="color: #166534;">
          ⚡ Quick Wins (High Impact, Low Effort)
        </div>
        <ul class="quad-action-list">
          {% for act in record.score_card.priority_actions if act.quadrant.value == 'Quick wins' %}
          <li class="quad-action-item">
            <span><strong>{{ act.title }}</strong> ({{ act.affected_pages_count }} pages)</span>
            <span class="pill pill-fail">Impact: {{ act.impact }}</span>
          </li>
          {% else %}
          <li style="color: #64748B; font-style: italic;">No critical quick wins identified.</li>
          {% endfor %}
        </ul>
      </div>

      <!-- Major Projects -->
      <div class="quadrant quad-major-projects">
        <div class="quad-title" style="color: #1E40AF;">
          🏗️ Major Projects (High Impact, High Effort)
        </div>
        <ul class="quad-action-list">
          {% for act in record.score_card.priority_actions if act.quadrant.value == 'Major projects' %}
          <li class="quad-action-item">
            <span><strong>{{ act.title }}</strong> ({{ act.affected_pages_count }} pages)</span>
            <span class="pill pill-warning">Impact: {{ act.impact }}</span>
          </li>
          {% else %}
          <li style="color: #64748B; font-style: italic;">No major projects required.</li>
          {% endfor %}
        </ul>
      </div>

      <!-- Fill-Ins -->
      <div class="quadrant quad-fill-ins">
        <div class="quad-title" style="color: #854D0E;">
          🧹 Fill-Ins (Low Impact, Low Effort)
        </div>
        <ul class="quad-action-list">
          {% for act in record.score_card.priority_actions if act.quadrant.value == 'Fill-ins' %}
          <li class="quad-action-item">
            <span>{{ act.title }}</span>
            <span class="pill pill-info">Impact: {{ act.impact }}</span>
          </li>
          {% else %}
          <li style="color: #64748B; font-style: italic;">None</li>
          {% endfor %}
        </ul>
      </div>

      <!-- Thankless Tasks -->
      <div class="quadrant quad-thankless">
        <div class="quad-title" style="color: #475569;">
          ⏳ Low Priority / Hard Tasks
        </div>
        <ul class="quad-action-list">
          {% for act in record.score_card.priority_actions if act.quadrant.value == 'Thankless tasks' %}
          <li class="quad-action-item">
            <span>{{ act.title }}</span>
            <span class="pill pill-not-measured">Effort: {{ act.effort }}</span>
          </li>
          {% else %}
          <li style="color: #64748B; font-style: italic;">None</li>
          {% endfor %}
        </ul>
      </div>
    </div>
    {% endif %}

    <!-- Detailed Findings Section -->
    <div class="page-break"></div>
    <div class="section-title">Audit Findings & Verification Evidence</div>
    <div>
      {% for f in record.findings %}
      <div class="finding-card">
        <div class="finding-header">
          <div class="finding-title">{{ f.title }}</div>
          <div>
            <span class="pill pill-{{ f.status.value }}">{{ f.status.value }}</span>
            <span class="pill pill-info">{{ f.layer.value }}</span>
          </div>
        </div>
        <div class="finding-meta">
          URL: <code>{{ f.url }}</code> | Severity: <strong>{{ f.severity.value | upper }}</strong> | Impact: {{ f.impact }}/5 | Effort: {{ f.effort.value }}
        </div>
        <div style="font-size: 13px; color: #475569;">
          {{ f.why_it_matters }}
        </div>
        {% if f.status.value != 'pass' and f.fix %}
        <div class="finding-guidance">
          <strong>Recommended Fix:</strong> {{ f.fix }}
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>

    <!-- Appendix & Methodology -->
    <div class="page-break"></div>
    <footer>
      <p>
        {{ branding.report_settings.disclaimer | default('Generated by AuditIQ Enterprise AI Audit Engine.') }}
      </p>
      <p style="margin-top: 6px;">
        Agency Contact: {{ branding.agency.email | default('support@auditiq.local') }} | {{ branding.agency.website | default('https://auditiq.local') }}
      </p>
    </footer>
  </div>
</body>
</html>
